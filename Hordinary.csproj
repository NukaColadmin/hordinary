<Project Sdk="Godot.NET.Sdk/4.7.1">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hordinary</RootNamespace>
    <!--
      GodotSharp cible net8.0 mais seul le runtime .NET 10 est installe sur ce poste :
      LatestMajor autorise l'execution sur le runtime majeur disponible.
    -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <!-- Le SDK Godot compile tout le dossier : on exclut les projets voisins. -->
  <ItemGroup>
    <Compile Remove="Hordinary.Core/**" />
    <Compile Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Hordinary.Core/Hordinary.Core.csproj" />
  </ItemGroup>

</Project>
