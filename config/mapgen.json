// Generation de quartiers (livrable 13).
//
// Une mission qui declare un "map_profile" ne se joue plus sur la carte dessinee : un quartier est
// genere pour elle, a chaque depart, et rien en aval ne sait qu'il l'a ete. Une mission sans
// "map_profile" continue de se jouer sur la carte de demonstration, qui reste livree et testee.
//
// Un profil ne contient que des intervalles et des probabilites : ajouter une ambiance est une
// entree de plus ici, jamais du code. Un intervalle s'ecrit [min, max], bornes incluses ; un nombre
// seul est un intervalle degenere.
//
// LA CEINTURE
// Une carte finie ne doit ni ressembler a une carte finie, ni laisser croire qu'on peut continuer.
// La reponse tient en une couche : le brouillard. Il est visible, il est infranchissable, il dit de
// lui-meme pourquoi on ne va pas plus loin, et il REMPLACE ce qui est au-dela au lieu de le cacher.
// Il n'y a donc ni bande de decor a rendre, ni fondu a calculer, ni terminaison de rue a raccorder :
// une rue qui atteint le bord entre dans le brouillard, et c'est tout ce qu'il y a a dire.
//
// "tile" est une cle de config/tile_legend.json, au format "source:x,y". Les deux ceintures livrees
// sont deux images d'une meme regle : changer l'une pour l'autre ne change rien au jeu, seulement ce
// que le joueur comprend de l'endroit ou il est.
//
// walkable_ratio
// La specification annoncait [0.35, 0.6]. C'est un chiffre qui suppose des batiments qui bloquent ;
// ici on y entre, et l'interieur d'un batiment est praticable — un pavillon de 12 x 13 cases n'a que
// 40 % de murs. Un quartier jouable tourne donc autour de 85 %, mesure sur 600 generations, et
// l'intervalle est cale la-dessus. La clause garde tout son sens : en dessous de 70 % le quartier est
// un labyrinthe, au-dessus de 90 % c'est un terrain vague avec deux maisons dessus — et c'est ce
// second cas, le plus frequent, que la relecture rejette.
//
// LE NOMMAGE
// Le generateur ne nomme aucun lieu : les gabarits sont ici, et {0} y recoit le point cardinal
// reellement occupe. L'ordre de "cardinals" porte du sens : 0 nord, 1 est, 2 sud, 3 ouest, 4 centre,
// puis des numeros. "Batiment nord" est donc au nord, sinon le nom mentirait au joueur.
{
  "max_generation_attempts": 8,

  "border": {
    "thickness": [2, 3],
    "breach_chance": 0.5,
    "breach_width": [2, 4],

    "kinds": [
      {
        "id": "fog",
        "name": "Brouillard",
        "tile": "3:0,0",
        "allows_breach": true
      },
      {
        "id": "radioactive_fog",
        "name": "Brouillard radioactif",
        "tile": "4:0,0",
        "allows_breach": true
      }
    ]
  },

  "naming": {
    "drop": "Point de depose",
    "extraction": "Point de depose (retour)",
    "building": "Batiment {0}",
    "main_road": "Rue principale",
    "street": "Rue {0}",
    "alley": "Ruelle {0}",
    "cardinals": ["nord", "est", "sud", "ouest", "centre"]
  },

  "profiles": [
    {
      "//": "Petit format : une rue, deux ou trois batiments. Missions courtes.",
      "id": "faubourg",
      "description": "Quelques pavillons le long d'une rue. On voit venir, et on est vu.",
      "size": 40,

      "blocks": [3, 4],
      "roads": { "main_width": [4, 5], "street_width": [2, 3], "alley_chance": 0.25 },
      "buildings": { "density": [0.45, 0.65], "footprint": [[5, 5], [8, 9]], "rooms": [2, 4] },
      "doors": { "per_building": [1, 3], "locked_chance": 0.3, "window_chance": 0.6 },

      "border_kinds": ["fog"],
      "objective_distance": [10, 22],
      "walkable_ratio": [0.70, 0.92],

      "props": {
        "heavy_per_block": [2, 5],
        "ground_items_per_building": [1, 3],
        "ground_items": ["canned_food", "water_can", "bandage", "flashlight", "toolbox"],
        "heavy_kinds": [
          { "kind": "shelf", "mass": 2, "outdoor": false },
          { "kind": "wardrobe", "mass": 4, "outdoor": false },
          { "kind": "dumpster", "mass": 4, "outdoor": true }
        ]
      }
    },

    {
      "//": "Format par defaut.",
      "id": "banlieue",
      "description": "Pavillons, rues larges, peu de couvert. On voit venir, et on est vu.",
      "size": 46,

      "blocks": [4, 5],
      "roads": { "main_width": [4, 6], "street_width": [2, 3], "alley_chance": 0.35 },
      "buildings": { "density": [0.45, 0.65], "footprint": [[5, 5], [10, 12]], "rooms": [2, 6] },
      "doors": { "per_building": [1, 3], "locked_chance": 0.35, "window_chance": 0.6 },

      "border_kinds": ["fog", "radioactive_fog"],
      "objective_distance": [12, 28],
      "walkable_ratio": [0.70, 0.90],

      "props": {
        "heavy_per_block": [2, 6],
        "ground_items_per_building": [0, 3],
        "ground_items": ["canned_food", "water_can", "bandage", "medikit", "fuel_can", "flashlight", "toolbox"],
        "heavy_kinds": [
          { "kind": "shelf", "mass": 2, "outdoor": false },
          { "kind": "wardrobe", "mass": 4, "outdoor": false },
          { "kind": "dumpster", "mass": 4, "outdoor": true },
          { "kind": "wreck", "mass": 5, "outdoor": true, "length": 2, "breadth": 2 }
        ]
      }
    },

    {
      "//": "Grand format : plusieurs batiments d'interet, ilots denses, ruelles frequentes.",
      "id": "centre_ville",
      "description": "Immeubles serres, ruelles, peu de lignes de vue. On ne voit jamais loin.",
      "size": 54,

      "blocks": [5, 7],
      "roads": { "main_width": [4, 6], "street_width": [2, 3], "alley_chance": 0.6 },
      "buildings": { "density": [0.55, 0.75], "footprint": [[6, 6], [12, 13]], "rooms": [4, 8] },
      "doors": { "per_building": [1, 3], "locked_chance": 0.45, "window_chance": 0.5 },

      "border_kinds": ["radioactive_fog", "fog"],
      "objective_distance": [14, 34],
      "walkable_ratio": [0.70, 0.90],

      "props": {
        "heavy_per_block": [3, 8],
        "ground_items_per_building": [0, 3],
        "ground_items": ["canned_food", "water_can", "bandage", "medikit", "ammo_box", "fuel_can", "radio", "firecracker"],
        "heavy_kinds": [
          { "kind": "shelf", "mass": 2, "outdoor": false },
          { "kind": "wardrobe", "mass": 4, "outdoor": false },
          { "kind": "dumpster", "mass": 4, "outdoor": true },
          { "kind": "wreck", "mass": 5, "outdoor": true, "length": 2, "breadth": 2 }
        ]
      }
    }
  ]
}
