// Objectifs de la Utility AI (specification section 11.2, livrable 4).
//
// Un objectif est une donnee : un nom, une cible, des preconditions et des considerations ponderees.
// Le code ne connait que les entrees primitives (perceived_danger, health_ratio, panic, distance_to,
// distance_to(cible), ...) et les courbes de reponse (linear, quadratic, inverse, threshold).
// Ajouter, retirer ("enabled": false) ou repondérer un objectif se fait ici, sans recompilation.
//
// Aucun objectif ne pousse plus un survivant a porter secours de lui-meme : HelpAlly, HealAlly,
// CalmAlly et Regroup ont ete retires au livrable 15, ou c'est le joueur qui decide des strategies.
// CreateDistraction est parti avec eux, et pour la meme raison : attirer la horde sur soi pour
// degager un allie n'est pas un reflexe, c'est un sacrifice calcule — personne ne le fait sans qu'on
// le lui demande. Le domaine a perdu du meme coup CreateNoiseDistraction et ThrowFirecracker.
// Le survivant garde ses reflexes personnels — fuir, se cacher, se soigner, se battre — et le groupe
// reste une cible atteignable ("group"), mais par un ordre du joueur, pas par un score.
//
// "obeying" ferme les quatre objectifs propres du survivant — explorer, chercher, ramasser, rentrer —
// tant qu'il execute l'ordre d'un camarade (action OrderAlly). C'est ce qui fait passer l'ordre en
// priorite, et c'est tout : les reflexes — fuir, se cacher, se soigner, se battre — n'ont pas cette
// precondition. On obeit a un camarade, on ne se laisse pas mordre pour lui. Le poids de l'ordre,
// lui, ne suffirait pas : PickUpObjective lit aussi player_priority et le depasse a courte distance.
//
// Lecture d'une consideration :
//   input     entree primitive lue dans la memoire du survivant, toujours entre 0 et 1
//   curve     forme de la reponse ; "exponent" durcit linear/quadratic/inverse
//   min/max   plage de sortie. min = 0 donne un droit de veto (la consideration peut annuler
//             l'objectif) ; min > 0 en fait un simple modulateur.
// Les considerations sont multipliees par defaut : une seule a 0 annule le score.
//
// "description" (nouveau champ, livrable 9) : phrase courte destinee a un lecteur humain ou a
// l'atelier de creation base sur un LLM local. C'est une vraie propriete JSON, pas un commentaire
// "//" : elle survit a une reecriture programmatique du fichier et peut etre affichee en jeu
// (ex. liste des missions ou des techniques enseignables).
{
  "goals": [
    {
      "name": "CompletePlayerMission",
      "description": "L'ordre du joueur. Il ne s'impose pas : la securite le fait fondre vite (courbe quadratique). Un ordre rempli cesse d'etre un objectif : sans cette precondition, un survivant arrive a destination resterait plante la au lieu de passer a ce que la consigne impliquait. C'est aussi l'objectif qui execute l'ordre d'un camarade (OrderAlly) : il arrive par le meme MissionOrder, au poids utility_ai.cooperation.order_priority, et se clot de lui-meme une fois rempli ou reconnu impossible (SurvivorAgent.SettleOrder).",
      "target": "mission",
      "preconditions": [ { "input": "mission_reached", "max": 0.5 } ],
      "considerations": [
        { "input": "player_priority", "curve": "linear" },
        { "input": "plan_confidence", "curve": "linear", "min": 0.3 },
        { "input": "personal_safety", "curve": "quadratic" }
      ],
      "combine": "multiply"
    },

    {
      "name": "ExploreUnknownArea",
      "description": "Decouvrir le terrain quand rien de plus urgent ne se presente. La cible « frontier » n'est plus la frontiere la plus proche mais la mieux notee (livrable 7) : gain d'information attendu, moins le trajet, le danger et ce qu'un allie explore deja. C'est ce dernier terme, et lui seul, qui repartit les trois survivants au lieu de les envoyer au meme endroit — aucun d'eux n'est meilleur explorateur qu'un autre. « has_objective » ferme l'objectif une fois la caisse dans le sac : sans cette precondition, un porteur arrive au van voyait « ReachExtraction » se fermer sur « at_extraction », repartait explorer, redevenait loin de l'extraction — et faisait l'aller-retour indefiniment. Celui qui rapporte ce que tout le monde est venu chercher ne repart pas en reconnaissance : decider d'aller voir ailleurs avec la caisse sur le dos est une strategie, elle revient au joueur.",
      "target": "frontier",
      "preconditions": [
        { "input": "frontier_known", "min": 0.5 },
        { "input": "has_objective", "max": 0.5 },
        { "input": "obeying", "max": 0.5 }
      ],
      "considerations": [
        { "input": "unexplored_ratio", "curve": "linear" },
        { "input": "personal_safety", "curve": "linear" }
      ],
      "weight": 0.55
    },

    {
      "name": "FleeDanger",
      "description": "flee_score de la section 11.3. La pression ressentie garde son droit de veto ; sante et panique ne font que moduler : un survivant calme et en pleine forme fuit quand meme une horde a trois cases. « at_extraction » ferme l'objectif au van, et seulement la : le van est le seul endroit du quartier ou l'on ne peut pas etre frappe (EntityManager.Sheltered), donc le seul ou fuir revient a courir vers le danger. Sans cette precondition, un survivant rentre voyait « ReachExtraction » se fermer sur « at_extraction », fuyait pour un score de 0,15, ressortait, redevenait mordable — et refaisait le trajet. Rester sous la tole n'est pas tenir la position : il n'y a rien a tenir.",
      "target": "away_from_danger",
      "preconditions": [ { "input": "at_extraction", "max": 0.5 } ],
      "considerations": [
        { "input": "threat_pressure", "curve": "linear" },
        { "input": "health_ratio", "curve": "inverse", "min": 0.7 },
        { "input": "panic", "curve": "linear", "min": 0.7 }
      ],
      "combine": "multiply"
    },

    {
      "name": "HealSelf",
      "description": "Se soigner : il faut de quoi le faire, etre blesse, et un moment de repit. « has_remedy » et non « has_objective » : ce qui soigne est n'importe quel objet porte qui declare un effet de soin, pas la caisse qu'on est venu chercher — et le survivant entame un bandage avant d'ouvrir ce qu'il rapporte.",
      "preconditions": [
        { "input": "has_remedy", "min": 0.5 },
        { "input": "health_ratio", "max": 0.6 }
      ],
      "considerations": [
        { "input": "health_ratio", "curve": "inverse", "exponent": 2 },
        { "input": "personal_safety", "curve": "linear" },
        { "input": "panic", "curve": "inverse", "min": 0.3 }
      ],
      "weight": 0.9
    },

    {
      "name": "SearchForObjective",
      "description": "Aller fouiller le lieu de la mission tant qu'on ignore ou est ce qu'on vient chercher. La cible n'est pas la pharmacie mais « objective_zone » : le lieu que la mission a designe, quel qu'il soit. Les deux dernieres preconditions sont ce qui empeche une quete sans fin. « objective_zone_searched » ferme l'objectif des que la fouille a ete faite et n'a rien donne : sans elle, un survivant revenu bredouille rescore la recherche a chaque decision et repart chercher une caisse qui n'existe plus — quelqu'un l'avait prise avant lui, ou il n'y en avait jamais eu.",
      "target": "objective_zone",
      "preconditions": [
        { "input": "has_objective", "max": 0.5 },
        { "input": "objective_known", "max": 0.5 },
        { "input": "objective_zone_searched", "max": 0.5 },
        { "input": "obeying", "max": 0.5 }
      ],
      "considerations": [
        { "input": "player_priority", "curve": "linear", "min": 0.4 },
        { "input": "personal_safety", "curve": "linear" },
        { "input": "unexplored_ratio", "curve": "linear", "min": 0.4 }
      ],
      "weight": 0.8
    },

    {
      "name": "PickUpObjective",
      "description": "L'objet de la mission est repere : aller le prendre passe devant la consigne generale.",
      "target": "objective",
      "preconditions": [
        { "input": "has_objective", "max": 0.5 },
        { "input": "objective_known", "min": 0.5 },
        { "input": "objective_reachable", "min": 0.5 },
        { "input": "obeying", "max": 0.5 }
      ],
      "considerations": [
        { "input": "player_priority", "curve": "linear", "min": 0.4 },
        { "input": "distance_to(objective)", "curve": "inverse", "min": 0.4 },
        { "input": "personal_safety", "curve": "linear" }
      ],
      "weight": 1.3
    },

    {
      "name": "ReachExtraction",
      "description": "L'objet de la mission en poche : sortir. La securite reste un modulateur fort. « at_extraction » clot l'objectif une fois sur place : sans elle, un survivant arrive au camp se redonne indefiniment un plan de sortie d'une action, et le journal se remplit d'un aller-retour immobile.",
      "target": "extraction",
      "preconditions": [
        { "input": "has_objective", "min": 0.5 },
        { "input": "at_extraction", "max": 0.5 },
        { "input": "obeying", "max": 0.5 }
      ],
      "considerations": [
        { "input": "player_priority", "curve": "linear", "min": 0.5 },
        { "input": "personal_safety", "curve": "linear", "min": 0.3 }
      ],
      "weight": 1.1
    },

    {
      "name": "Hide",
      "description": "Se terrer plutot que courir : demande un abri connu tout proche. Se cacher marche contre ce qui ne vous a pas vu, pas contre ce qui vous suit : « pursued » divise le score par trois quand un zombie vient droit sur elle, et la fuite reprend la main. Meme precondition que « FleeDanger », et pour la meme raison : on ne quitte pas le van pour aller se cacher moins bien.",
      "target": "cover",
      "preconditions": [ { "input": "at_extraction", "max": 0.5 } ],
      "considerations": [
        { "input": "perceived_danger", "curve": "linear" },
        { "input": "distance_to(cover)", "curve": "inverse" },
        { "input": "panic", "curve": "linear", "min": 0.5 },
        { "input": "pursued", "curve": "inverse", "min": 0.3 }
      ],
      "weight": 0.9
    },

    {
      "name": "FightZombie",
      "description": "Se battre quand partir n'est plus la meilleure idee (livrable 8). « pursued » est la precondition : un zombie loin ne se combat pas, il s'evite — et il n'existe aucune action pour aller au contact. Deux considerations decident ensuite du reste. La sante en courbe inverse est celle du MVP : un survivant acule et blesse se retourne. « armed » est la seconde, et c'est elle qui donne un sens a l'arme que le joueur a confiee au depart — les mains vides, l'objectif ne pese plus qu'un tiers, et fuir reprend la main. Un seul poursuivant se regle donc au fusil ; deux restent une raison de courir, parce que le danger ressenti s'accumule quand la poursuite, elle, ne retient que le pire des deux.",
      "target": "danger",
      "preconditions": [ { "input": "pursued", "min": 0.35 } ],
      "considerations": [
        { "input": "pursued", "curve": "linear" },
        { "input": "health_ratio", "curve": "inverse", "min": 0.55 },
        { "input": "armed", "curve": "linear", "min": 0.3 }
      ],
      "weight": 1.0
    }
  ]
}
