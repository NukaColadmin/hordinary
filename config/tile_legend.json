// Ce qu'une tuile du TileSet veut dire pour la simulation.
//
// C'est le seul endroit qui sait que la tuile 0:5,0 est un mur : repeindre l'atlas ne demande que de
// modifier ce fichier, jamais une recompilation.
//
// Cle = "source:x,y" : identifiant de source du TileSet, puis coordonnees de cellule dans son atlas.
// Sources : 0 = Assets/atlas.png (grille 8 x 8 de tuiles 32 x 32, sans separation),
//           1 = Assets/Structures/DoorClosed.png, 2 = Assets/Structures/DoorOpen.png,
//           3 = Assets/Edges/EdgesFog.png, 4 = Assets/Edges/EdgesRadioactiveFog.png.
// Les portes gardent leur source propre : c'est ce qui laisse les coordonnees 1:0,0 et 2:0,0
// inchangees depuis le MVP, et avec elles le tile_map_data de Scenes/Main.tscn.
//
// Deux ecritures pour une entree :
//   "0:5,0": "Wall"                                        un terrain, rien de plus
//   "0:0,3": { "kind": "Ignored", "item": "canned_food" }   un objet pose sur ce qu'il y a dessous
//   "0:2,0": { "kind": "FloorIndoor", "item": "medikit" }   les deux a la fois
//
// Le champ "item" est un identifiant de config/items.json ou config/weapons.json. Un test verifie la
// correspondance dans les deux sens : aucun objet du catalogue sans tuile, aucune tuile pointant
// vers un objet qui n'existe pas.
//
// Deux regles heritees, a ne pas enfreindre :
//   * aucune tuile n'encode un etat d'execution. Il n'existe pas de tuile « porte verrouillee »
//     parce que le verrouillage est un etat, pas un terrain ; pour la meme raison il n'existe pas de
//     tuile « porte barricadee » : barricader verrouille une porte, cela n'en peint pas une autre.
//   * une tuile de sol ne change rien au jeu. Les variantes de sol ci-dessous se ramenent toutes a
//     CellType.Floor et au meme marqueur interieur / exterieur : elles servent a lire la carte,
//     jamais a la modifier.
//
// Deux terrains font exception a la seconde regle, et c'est declare plutot que deduit du dessin :
// WindowBarred est un mur qui rend BreakWindow indisponible, ShutterHalf une porte fermee qu'on
// ouvre mais qu'on ne force jamais.
{
  "tile_size": 32,

  "tiles": {
    "//rangee 0": "Tuiles heritees du MVP. Leurs coordonnees sont gelees : la carte dessinee a la main en depend.",
    "0:2,0": { "kind": "FloorIndoor", "item": "medikit" },
    "0:3,0": "WindowBroken",
    "0:4,0": "Window",
    "0:5,0": "Wall",
    "0:6,0": "FloorIndoor",
    "0:7,0": "FloorOutdoor",

    "1:0,0": "DoorClosed",
    "2:0,0": "DoorOpen",

    "//ceinture": "La ou le quartier s'arrete (livrable 13). Une seule famille de tuiles, le brouillard, et elle remplace tout ce qui se trouve au-dela : ni bande de decor, ni fondu dessine. Les deux entrees sont deux images de la meme regle ; c'est config/mapgen.json qui dit laquelle un quartier emploie, en citant la cle ci-dessous.",
    "3:0,0": "Border",
    "4:0,0": "Border",

    "//rangee 1": "Variantes de sol. Purement visuelles : c'est ce qui permet de distinguer une rue d'une piece sans lire une legende. FloorRoad, FloorSidewalk et FloorGrass sont des FloorOutdoor nommes — meme type de cellule, meme marqueur exterieur, aucun effet sur le jeu. Le nom ne sert qu'au peintre, qui demande la chaussee pour une voie et l'herbe pour une friche au lieu de prendre partout la premiere tuile venue.",
    "0:0,1": "FloorRoad",
    "0:1,1": "FloorSidewalk",
    "0:2,1": "FloorGrass",
    "0:3,1": "FloorIndoor",
    "0:4,1": "FloorIndoor",
    "0:5,1": "FloorPharmacy",

    "//rangee 2": "Decor bloquant. Obstacle bloque le deplacement ET la vue ; c'est ce qui manquait le plus au jeu de tuiles du MVP.",
    "0:0,2": "Obstacle",
    "0:1,2": "Obstacle",
    "0:2,2": "Obstacle",
    "0:3,2": "Obstacle",
    "0:4,2": "Obstacle",

    "//rangee 3": "Objets au sol. Ils ne changent pas le terrain : la tuile de sol dessous fait foi.",
    "0:0,3": { "kind": "Ignored", "item": "canned_food" },
    "0:1,3": { "kind": "Ignored", "item": "water_can" },
    "0:2,3": { "kind": "Ignored", "item": "bandage" },
    "0:3,3": { "kind": "Ignored", "item": "medikit" },
    "0:4,3": { "kind": "Ignored", "item": "fuel_can" },
    "0:5,3": { "kind": "Ignored", "item": "ammo_box" },
    "0:6,3": { "kind": "Ignored", "item": "flashlight" },
    "0:7,3": { "kind": "Ignored", "item": "radio" },

    "//rangee 4": "Objets au sol (suite) et les cinq armes.",
    "0:0,4": { "kind": "Ignored", "item": "firecracker" },
    "0:1,4": { "kind": "Ignored", "item": "toolbox" },
    "0:2,4": { "kind": "Ignored", "item": "revolver" },
    "0:3,4": { "kind": "Ignored", "item": "shotgun" },
    "0:4,4": { "kind": "Ignored", "item": "baseball_bat" },
    "0:5,4": { "kind": "Ignored", "item": "crowbar" },
    "0:6,4": { "kind": "Ignored", "item": "machete" },

    "//rangee 5": "Camp : nourriture et eau, chaque reserve en trois etats lus dans config/camp.json (plein > 60 %, bas 10 a 60 %, vide < 10 %). Le mobilier du camp bloque le passage comme n'importe quel meuble.",
    "0:0,5": "Obstacle",
    "0:1,5": "Obstacle",
    "0:2,5": "Obstacle",
    "0:4,5": "Obstacle",
    "0:5,5": "Obstacle",
    "0:6,5": "Obstacle",

    "//rangee 6": "Camp : essence, feu, couchages, etabli.",
    "0:0,6": "Obstacle",
    "0:1,6": "Obstacle",
    "0:2,6": "Obstacle",
    "0:4,6": "Obstacle",
    "0:5,6": "Obstacle",
    "0:6,6": "Obstacle",

    "//rangee 7": "Tuiles de zone. Les pompes donnent le seul couvert de l'esplanade ; les lits de camp et les casiers du centre d'accueil sont fouillables et bloquent la vue.",
    "0:0,7": "Obstacle",
    "0:1,7": "Obstacle",
    "0:2,7": "WindowBarred",
    "0:3,7": "ShutterHalf",
    "0:4,7": "Obstacle",
    "0:5,7": "Obstacle"
  }
}
