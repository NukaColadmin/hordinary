      "effects": [ "!has(agent, noisemaker)", "diversion_made" ],
      "cost": 2,
      "noise_level": 0,
      "duration": 1.5
    },

    {
      "name": "BorrowWeapon",
      "description": "Emprunter l'arme de rechange d'un camarade. Le repere « lender » est l'allie le plus proche qui a dit en porter une : on voit ce qu'un camarade tient, pas ce qu'il a dans son sac, et c'est la conversation qui l'apprend. L'arme passe de sac en sac avec son usure (Inventory.HandTo) et vient en main. Duree nulle : le geste se fait en passant. Avec une seconde, le preteur — qui ne s'arrete pas pour autant — avait le temps de s'eloigner d'une case, et le moniteur annulait l'emprunt sur « at(agent, lender) » devenu faux.",
      "verb": "setFlag",
      "params": { "condition": "armed", "value": true, "target": "lender" },
      "preconditions": [ "at(agent, lender)", "!armed" ],
      "effects": [ "armed" ],
      "cost": 1,
      "noise_level": 0,
      "duration": 0
    },

    {
      "name": "TendAlly",
      "description": "Soigner un camarade blesse avec ce qu'on porte. Le repere « patient » est l'allie le plus proche qu'on sait sous utility_ai.cooperation.wounded_ratio — su, et non devine : la sante d'un allie se raconte. Le montant est celui du remede, ou a defaut la fiche du soignant : Claire, secouriste, rend davantage avec la meme trousse.",
      "verb": "setFlag",
      "params": { "condition": "band_tended", "value": true, "target": "patient" },
      "preconditions": [ "at(agent, patient)", "has(agent, remedy)", "!band_tended" ],
      "effects": [ "!has(agent, remedy)", "band_tended" ],
      "cost": 1,
      "noise_level": 0,
      "duration": 2
    },

    {
      "name": "OrderAlly",
      "description": "Ordonner a un camarade d'aller a un lieu. Le plan vise le repere « ally » ; l'ordre part a qui l'entend reellement — a portee de voix, ou de radio si les deux en portent une — et qui l'accepte : on ne supplante ni le rappel du van ni l'ordre d'un autre camarade pas encore rempli. Le camarade l'execute avec sa propre boucle de decision, en priorite sur ses objectifs (entree « obeying ») mais pas sur ses reflexes, et l'ordre s'efface une fois rempli ou reconnu impossible, rendant la place a celui qu'il avait mis de cote. « ordered(?location) » se lit dans la memoire des deux bouts : celui qui a donne l'ordre et celui qui l'a recu.",
      "verb": "setFlag",
      "parameters": { "location": "location" },
      "params": { "condition": "ordered(?location)", "value": true, "target": "?location" },
      "preconditions": [ "at(agent, ally)", "known(?location)", "!ordered(?location)" ],
      "effects": [ "ordered(?location)" ],
      "cost": 1,
      "noise_level": 1,
      "duration": 1
    },

    {
      "name": "OrderBand",
      "description": "Rappeler tout le groupe a un lieu : le meme ordre qu'OrderAlly, donne a chaque camarade qui l'entend et l'accepte, et non au premier. « Tous » veut dire tous ceux qui l'entendent — a portee de voix, ou de radio si les deux en portent une ; un camarade hors de portee ne recoit rien, et le plan ne va pas le chercher. D'ou le repere « ally » : on va trouver le camarade le plus proche, et l'ordre part de la. Un geste distinct d'OrderAlly, et non un reglage de celui-ci, parce que c'est au joueur de dire s'il renvoie un camarade ou rappelle tout le monde. Plus bruyant et plus cher d'un point : on crie, ou l'on appelle sur la radio. Et instantane, quand OrderAlly dure une seconde : c'est mesure dans le moteur, pas dans le harnais — pendant cette seconde, les camarades qu'on est venu trouver font un pas, « at(agent, ally) » tombe, et le plan invalide courait apres eux jusqu'au rappel du van. « band_ordered(?location) » se lit dans la memoire de celui qui a rappele et de chacun de ceux qui ont obei.",
      "verb": "setFlag",
      "parameters": { "location": "location" },
      "params": { "condition": "band_ordered(?location)", "value": true, "target": "?location" },
      "preconditions": [ "at(agent, ally)", "known(?location)", "!band_ordered(?location)" ],
      "effects": [ "band_ordered(?location)" ],
      "cost": 2,
      "noise_level": 2,
      "duration": 0
    }
  ],

  // A quoi reconnait-on qu'un objectif de config/utility_goals.json est atteint. Les noms font le
  // lien entre le livrable 4 (choisir un objectif) et le livrable 5 (le realiser). La description
  // de chaque objectif proprement dite vit dans config/utility_goals.json ; celle-ci ne repete que
  // la condition de reussite, cote planificateur.
  "goals": [
    { "name": "PickUpObjective", "description": "Reussi quand l'agent porte ce que la mission envoyait chercher.", "conditions": [ "has(agent, objective)" ] },
    { "name": "SearchForObjective", "description": "Reussi quand l'emplacement de l'objet de la mission est connu.", "conditions": [ "objective_found" ] },
    { "name": "ReachExtraction", "description": "Reussi quand l'agent a atteint la zone d'extraction avec ce qu'il etait venu chercher.", "conditions": [ "extracted" ] },
    { "name": "CompletePlayerMission", "description": "Reussi quand l'agent a atteint le lieu designe par la consigne du joueur.", "conditions": [ "at(agent, mission)" ] },
    { "name": "ExploreUnknownArea", "description": "Reussi quand la frontiere visee a ete atteinte et observee.", "conditions": [ "explored" ] },
    { "name": "FleeDanger", "description": "Reussi quand l'agent a rejoint un point hors de portee du danger percu.", "conditions": [ "at(agent, away_from_danger)" ] },
    { "name": "Hide", "description": "Reussi quand l'agent est arrive dans une cachette connue.", "conditions": [ "hidden" ] },
    { "name": "ShareKnowledge", "description": "Reussi quand un allie a recu ce que le survivant savait.", "conditions": [ "knowledge_shared" ] },
    { "name": "HealSelf", "description": "Reussi quand l'agent s'est soigne lui-meme.", "conditions": [ "healed(agent)" ] },
    { "name": "FightZombie", "description": "Reussi quand la menace au contact a ete traitee — repoussee ou mise a terre. Un seul objectif pour deux actions : c'est GBFS qui arbitre entre la poussee, moins chere et plus discrete, et l'attaque, qui regle le probleme mais s'entend de loin.", "conditions": [ "threat_handled" ] }
  ],

  // Les lieux dont le domaine parle sans qu'aucune action ne les pose. Ils ne changent rien a la
  // recherche : PddlDomainBuilder les declare a l'export (un planificateur tiers refuse un predicat
  // non declare) et ConstraintGrammar s'en sert comme vocabulaire, puisqu'une instruction du joueur
  // ne peut nommer que ce que le domaine connait.
  //
  //   kinds       categories de lieux, une par predicat unaire : building(entrepot_ouest). C'est ce
  //               qui donne un sens a la classe de schemas « enter:building » du livrable 15.
  //   landmarks   reperes recalcules a chaque decision — le barycentre du groupe, une cachette, une
  //               frontiere. Ce sont des objets du probleme, figes a leur valeur du moment. « lender »,
  //               « patient » et « decoy » sont ceux de l'entraide : l'allie qui peut preter une arme,
  //               le blesse le plus proche, et ou lancer un petard (UtilityContext).
  //
  // Attention : declarer une categorie ici ne la fait pas exister sur la carte. C'est
  // SymbolicStateBuilder qui doit emettre building(...) pour les zones de map_locations.json ; tant
  // qu'il ne le fait pas, une contrainte portant sur ces lieux est acceptee et signalee sans effet.
  "places": {
    "kinds": [ "building", "street", "alley", "pharmacy", "extraction", "start" ],
    "landmarks": [ "group", "cover", "frontier", "away_from_danger", "mission", "lender", "patient", "decoy" ]
  },

  // Ce que chaque symbole nommable VEUT DIRE, dans les mots d'un joueur. C'est la seule section du
  // fichier ecrite pour le service de langage du livrable 15 : elle voyage dans le digest
  // (DomainDigest.Glossary) et le noeud « context » l'ecrit en face de chaque symbole.
  //
  // Pourquoi elle existe. Le digest transmettait le nom et le type de chaque symbole, jamais son
  // sens : « band_tended() » ne dit pas « les blesses sont panses », et « Soignez les blesses avant
  // d'entrer » — le libelle meme d'une consigne pre-ecrite — etait refusee comme un enchainement
  // d'actions. Le few-shot l'avait deja montre pour « group » : le type se transmet, le sens se devine.
  //
  // Pourquoi ici et pas dans le prompt du service. Une liste de correspondances ecrite cote service
  // serait un second vocabulaire, qui prendrait du retard sur celui-ci sans que rien ne le signale.
  // Ici, un symbole ajoute au domaine sans definition fait echouer
  // InstructionServiceTests.Chaque_symbole_nommable_a_sa_definition, et une definition dont le
  // symbole a disparu aussi.
  //
  // Ce n'est PAS le champ « description » des actions : celui-la explique au concepteur pourquoi
  // l'action est faite ainsi (couts, bruit, pieges), et le donner au modele lui apprendrait des
  // decisions de conception au lieu du sens des mots. Une definition tient en une ligne, dit ce que
  // le symbole designe, et jamais quand l'employer.
  //
  // Une meme cle vaut pour tout ce qui porte ce nom : « extraction » est a la fois une categorie de
  // lieu et le repere du van, et c'est le meme endroit.
