      "params": { "condition": "door_open(?door)", "value": true, "target": "?door" },
      "preconditions": [ "at(agent, ?location)", "door_of(?door, ?location)", "door_closed(?door)" ],
      "effects": [ "!door_closed(?door)", "door_open(?door)", "accessible(?location)" ],
