; Instantane : objectif « CompletePlayerMission », agent en (9,0).
; 25 objets connus, 52 faits, 105 actions instanciees.
; Ce que l'agent n'a jamais percu n'y figure pas : c'est voulu.

(define (problem completeplayermission)
  (:domain hordinary)
  (:objects
    alice - ally
    door_0_3 door_3_12 door_6_m2 - door
    entrepot_ouest hangar_sud rue_principale ruelle start - location
    window_12_m2 window_7_12 window_9_5 window_9_m6 window_m2_12 window_m4_4 window_m4_m6 window_m8_m1 - window
  )
  (:init
    (accessible ally)
    (accessible cover)
    (accessible entrepot_ouest)
    (accessible extraction)
    (accessible frontier)
    (accessible group)
    (accessible hangar_sud)
    (accessible mission)
    (accessible objective_zone)
    (accessible rue_principale)
    (accessible ruelle)
    (accessible start)
    (alley ruelle)
    (at agent cover)
    (at agent objective_zone)
    (building entrepot_ouest)
    (building hangar_sud)
    (door_closed door_0_3)
    (door_closed door_3_12)
    (door_closed door_6_m2)
    (door_of door_6_m2 objective_zone)
    (extraction extraction)
    (extraction_known)
    (known ally)
    (known cover)
    (known entrepot_ouest)
    (known extraction)
    (known frontier)
    (known group)
    (known hangar_sud)
    (known mission)
    (known objective_zone)
    (known rue_principale)
    (known ruelle)
    (known start)
    (pharmacy objective_zone)
    (searched objective_zone)
    (searched_in_vain objective_zone)
    (start start)
    (street rue_principale)
    (window_intact window_12_m2)
    (window_intact window_7_12)
    (window_intact window_9_5)
    (window_intact window_9_m6)
    (window_intact window_m2_12)
    (window_intact window_m4_4)
    (window_intact window_m4_m6)
    (window_intact window_m8_m1)
    (window_of window_12_m2 objective_zone)
    (window_of window_m2_12 hangar_sud)
    (window_of window_m4_m6 entrepot_ouest)
    (window_of window_m8_m1 entrepot_ouest)
    (= (total-cost) 0)
  )
  (:goal (and (at agent mission)))
  (:metric minimize (total-cost))
)
