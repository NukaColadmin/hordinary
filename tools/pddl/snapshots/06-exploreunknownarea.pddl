; Instantane : objectif « ExploreUnknownArea », agent en (-6,10).
; 20 objets connus, 40 faits, 1 actions instanciees.
; Ce que l'agent n'a jamais percu n'y figure pas : c'est voulu.

(define (problem exploreunknownarea)
  (:domain hordinary)
  (:objects
    bob claire - ally
    door_6_m2 - door
    ally away_from_danger cover danger entrepot_ouest extraction frontier group objective_zone rue_principale ruelle start - location
    window_m2_12 window_m4_4 window_m4_m6 window_m8_m1 - window
  )
  (:init
    (accessible ally)
    (accessible away_from_danger)
    (accessible cover)
    (accessible danger)
    (accessible entrepot_ouest)
    (accessible extraction)
    (accessible frontier)
    (accessible group)
    (accessible objective_zone)
    (accessible rue_principale)
    (accessible ruelle)
    (accessible start)
    (alley ruelle)
    (at agent away_from_danger)
    (building entrepot_ouest)
    (door_closed door_6_m2)
    (door_of door_6_m2 objective_zone)
    (extraction extraction)
    (extraction_known)
    (known ally)
    (known away_from_danger)
    (known cover)
    (known danger)
    (known entrepot_ouest)
    (known extraction)
    (known frontier)
    (known group)
    (known objective_zone)
    (known rue_principale)
    (known ruelle)
    (known start)
    (pharmacy objective_zone)
    (start start)
    (street rue_principale)
    (window_intact window_m2_12)
    (window_intact window_m4_4)
    (window_intact window_m4_m6)
    (window_intact window_m8_m1)
    (window_of window_m4_m6 entrepot_ouest)
    (window_of window_m8_m1 entrepot_ouest)
    (= (total-cost) 0)
  )
  (:goal (and (explored)))
  (:metric minimize (total-cost))
)
